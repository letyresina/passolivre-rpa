<?xml version='1.0' encoding='utf-8'?>
<b:definitions xmlns:b="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:d="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="https://passolivre.local/rpa"><b:process id="ProcessoTriagem" isExecutable="false"><b:startEvent id="start" name="Iniciar lote" /><b:task id="read" name="Ler e validar CSV" /><b:exclusiveGateway id="valid" name="Lote válido?" /><b:task id="logfail" name="Auditar falha / preservar resultado" /><b:endEvent id="endfail" name="Interromper" /><b:subProcess id="loop" name="Para cada linha: validar, consultar CEP, decidir e auditar"><b:documentation>Regras, decisões e recuperação descritas no PDD. Falhas de item são registradas; as demais linhas continuam.</b:documentation><b:multiInstanceLoopCharacteristics isSequential="true" /></b:subProcess><b:task id="save" name="Salvar resultado JSON" /><b:task id="panel" name="Painel consome a fila" /><b:endEvent id="end" name="Concluir" /><b:sequenceFlow id="s1" sourceRef="start" targetRef="read" name="" /><b:sequenceFlow id="s2" sourceRef="read" targetRef="valid" name="" /><b:sequenceFlow id="s3" sourceRef="valid" targetRef="loop" name="Sim" /><b:sequenceFlow id="s4" sourceRef="valid" targetRef="logfail" name="Não" /><b:sequenceFlow id="s5" sourceRef="logfail" targetRef="endfail" name="" /><b:sequenceFlow id="s6" sourceRef="loop" targetRef="save" name="Lote percorrido" /><b:sequenceFlow id="s7" sourceRef="save" targetRef="panel" name="" /><b:sequenceFlow id="s8" sourceRef="panel" targetRef="end" name="" /></b:process><d:BPMNDiagram id="Diagram"><d:BPMNPlane id="Plane" bpmnElement="ProcessoTriagem"><d:BPMNShape id="Shape_start" bpmnElement="start"><dc:Bounds x="220" y="20" width="34" height="34" /></d:BPMNShape><d:BPMNShape id="Shape_read" bpmnElement="read"><dc:Bounds x="152" y="80" width="170" height="48" /></d:BPMNShape><d:BPMNShape id="Shape_valid" bpmnElement="valid"><dc:Bounds x="214" y="158" width="48" height="48" /></d:BPMNShape><d:BPMNShape id="Shape_logfail" bpmnElement="logfail"><dc:Bounds x="390" y="150" width="180" height="64" /></d:BPMNShape><d:BPMNShape id="Shape_endfail" bpmnElement="endfail"><dc:Bounds x="463" y="250" width="34" height="34" /></d:BPMNShape><d:BPMNShape id="Shape_loop" bpmnElement="loop" isExpanded="false"><dc:Bounds x="122" y="248" width="230" height="84" /></d:BPMNShape><d:BPMNShape id="Shape_save" bpmnElement="save"><dc:Bounds x="152" y="377" width="170" height="48" /></d:BPMNShape><d:BPMNShape id="Shape_panel" bpmnElement="panel"><dc:Bounds x="152" y="470" width="170" height="48" /></d:BPMNShape><d:BPMNShape id="Shape_end" bpmnElement="end"><dc:Bounds x="220" y="562" width="34" height="34" /></d:BPMNShape><d:BPMNEdge id="Edge_s1" bpmnElement="s1"><di:waypoint x="237" y="54" /><di:waypoint x="237" y="80" /></d:BPMNEdge><d:BPMNEdge id="Edge_s2" bpmnElement="s2"><di:waypoint x="237" y="128" /><di:waypoint x="237" y="158" /></d:BPMNEdge><d:BPMNEdge id="Edge_s3" bpmnElement="s3"><di:waypoint x="237" y="206" /><di:waypoint x="237" y="248" /></d:BPMNEdge><d:BPMNEdge id="Edge_s4" bpmnElement="s4"><di:waypoint x="262" y="182" /><di:waypoint x="390" y="182" /></d:BPMNEdge><d:BPMNEdge id="Edge_s5" bpmnElement="s5"><di:waypoint x="480" y="214" /><di:waypoint x="480" y="250" /></d:BPMNEdge><d:BPMNEdge id="Edge_s6" bpmnElement="s6"><di:waypoint x="237" y="332" /><di:waypoint x="237" y="377" /></d:BPMNEdge><d:BPMNEdge id="Edge_s7" bpmnElement="s7"><di:waypoint x="237" y="425" /><di:waypoint x="237" y="470" /></d:BPMNEdge><d:BPMNEdge id="Edge_s8" bpmnElement="s8"><di:waypoint x="237" y="518" /><di:waypoint x="237" y="562" /></d:BPMNEdge></d:BPMNPlane></d:BPMNDiagram></b:definitions>